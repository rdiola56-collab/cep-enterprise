# CEP: ENTERPRISE settings for docker-compose.prod.yml.
# Copy to .env (cp .env.example .env), fill in, and keep .env private: it holds passwords.

# --- Required ---------------------------------------------------------------
# Your domain name (gets HTTPS automatically), or ":80" for plain HTTP on a private network.
CEP_SITE_ADDRESS=cep.example.com
# The address people type to open CEP, matching the line above.
CEP_APP_URL=https://cep.example.com
# Long random values. Generate each with:  openssl rand -hex 32
CEP_SECRET_KEY=
CEP_DB_PASSWORD=

# --- Outgoing email (optional; leave CEP_SMTP_HOST empty to keep it off) -----
CEP_SMTP_HOST=
CEP_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
CEP_SMTP_SECURITY=starttls
CEP_SMTP_USER=
CEP_SMTP_PASSWORD=
CEP_MAIL_FROM=CEP Estimating <cep@example.com>

# --- SAML single sign-on (optional) -------------------------------------------
# Give your identity provider:  <CEP_APP_URL>/api/auth/saml/metadata
CEP_SAML_IDP_METADATA_URL=
CEP_SAML_SP_BASE_URL=https://cep.example.com
CEP_SAML_LABEL=Sign in with SAML
CEP_SAML_EMAIL_ATTRIBUTE=
# A role to create unknown people with (e.g. viewer); empty = refuse them
CEP_SAML_AUTO_CREATE=

# --- OpenID Connect single sign-on (optional) ---------------------------------
CEP_OIDC_ISSUER=
CEP_OIDC_CLIENT_ID=
CEP_OIDC_CLIENT_SECRET=
CEP_OIDC_REDIRECT_URI=https://cep.example.com/login/sso

# --- Revit import through Autodesk Platform Services (optional) ---------------
CEP_APS_CLIENT_ID=
CEP_APS_CLIENT_SECRET=
# US or EMEA
CEP_APS_REGION=US
